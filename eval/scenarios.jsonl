# HOSTEL
# ===========================================================================
{"id": "sc-008", "question": "My parents want to stay in the hostel for two days when they visit me. What do they need to do?", "category": "scenario", "split": "heldout", "answerable": true, "expected_citations": ["srm/residence/guest_accommodation"], "required_values": ["7"], "forbidden_values": [], "note": "Subject to availability, a parent needing a short stay (one or two days only) must inform the hostel office at least 7 days before; charges depend on the room type (9.1)."}
{"id": "sc-009", "question": "My friend is a day scholar. Can he stay overnight in my hostel room?", "category": "scenario", "split": "tuning", "answerable": true, "expected_citations": ["srm/residence/guest_accommodation", "srm/residence/visitors_to_the_hostels-2"], "required_values": [], "forbidden_values": [], "note": "No. Day scholars are not permitted to stay in the hostel as guests (9.2), and overnight stay by visitors is not permitted (Visitors section)."}
{"id": "sc-010", "question": "I live in a girls' hostel. Can my male cousin come inside to visit me?", "category": "scenario", "split": "heldout", "answerable": true, "expected_citations": ["srm/residence/visitors_to_the_hostels-2"], "required_values": [], "forbidden_values": [], "note": "No. Male visitors to female hostels (other than parents) are not allowed, and even that is permitted up to the reception only."}
{"id": "sc-011", "question": "A friend stayed overnight in my room without the hostel's approval. What will happen to me?", "category": "scenario", "split": "tuning", "answerable": true, "expected_citations": ["srm/residence/visitors_to_the_hostels-2"], "required_values": [], "forbidden_values": [], "note": "The host will be fined, and the case will be referred to the Disciplinary Committee."}
{"id": "sc-012", "question": "I want to keep my own 150W air cooler in my hostel room. How much will it cost per year?", "category": "scenario", "split": "heldout", "answerable": true, "expected_citations": ["srm/residence/other_charges"], "required_values": ["5000"], "forbidden_values": ["2500"], "note": "An air cooler from 101 to 200W is charged Rs 5000 per year, with prior approval of the hostel warden (10.3). Rs 2500 is the rate up to 100W."}
{"id": "sc-013", "question": "I fell sick at 2 am in the hostel. Who should I contact, and is an ambulance available?", "category": "scenario", "split": "tuning", "answerable": true, "expected_citations": ["srm/residence/26.0-medical_assistance"], "required_values": ["24"], "forbidden_values": [], "note": "At night, contact the hostel deputy warden/SRO; an ambulance is available on campus 24 hours (26.0)."}
{"id": "sc-014", "question": "My laptop was stolen from my hostel room. Will the hostel take up my complaint?", "category": "scenario", "split": "heldout", "answerable": true, "expected_citations": ["srm/residence/ragging-2"], "required_values": [], "forbidden_values": [], "note": "No. The hostel administration will not entertain any complaint regarding theft of cell phones, laptops or other electronic gadgets (16.x, which the extracted document files under the section labelled ragging-2)."}
{"id": "sc-015", "question": "Can I stay in the hostel during the summer vacation to finish my project?", "category": "scenario", "split": "tuning", "answerable": true, "expected_citations": ["srm/residence/25.0-summer_winter_break"], "required_values": [], "forbidden_values": [], "note": "All hostellers must vacate during the summer vacation; a student advised by the university to stay for academic reasons may be allowed, as decided by the hostel administration (25.0)."}
{"id": "sc-016", "question": "I paid my hostel fees but now I do not want the room. Will I get my money back?", "category": "scenario", "split": "heldout", "answerable": true, "expected_citations": ["srm/residence/refund_of_hostel_fees"], "required_values": [], "forbidden_values": [], "note": "Fees once paid are not refunded normally; under special circumstances a procedure is followed."}
