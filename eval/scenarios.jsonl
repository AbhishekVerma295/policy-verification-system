# Scenario-based question set for the Policy Verification System.
#
# Each question describes a situation in a user's own words. Answering means
# finding the rule that governs it and applying it, not quoting a figure the
# question already names. Same schema as eval/adversarial.jsonl
# (src/policyverify/evalset.py), category "scenario".
#
# Every label below was written from the policy text itself (data/processed/,
# re-ingested 2026-11-20), and every expected citation and required value is
# checked against the index by
#     python scripts/validate_evalset.py --evalset eval/scenarios.jsonl
# Unanswerable items were confirmed absent by searching the whole corpus for
# the topic (search terms are in each note).
#
# Splits alternate so both halves cover every policy. Tune on "tuning";
# report on "heldout".
#
# ===========================================================================
# ATTENDANCE AND EXAMINATIONS
# ===========================================================================
{"id": "sc-001", "question": "I have 72% attendance in one of my courses. Can I write the end semester exam for that course?", "category": "scenario", "split": "tuning", "answerable": true, "expected_citations": ["srm/attendance/7.3-minimum_attendance", "srm/attendance/7.4-attendance_shortage_and_examination"], "required_values": ["75"], "forbidden_values": ["70%", "65%"], "note": "No. Below 75% in a course the student is not permitted to write that course's end semester exam and gets an 'I' grade (7.3, 7.4). Condonation (7.5) is the only route and is not automatic."}
{"id": "sc-002", "question": "I missed two weeks of classes because I was in hospital. Does that count against my attendance?", "category": "scenario", "split": "heldout", "answerable": true, "expected_citations": ["srm/attendance/7.3-minimum_attendance"], "required_values": ["25"], "forbidden_values": [], "note": "The 75% minimum is exclusive of leave of absence for medical reasons, accidents, on-duty etc., which can add up to 25% (7.3)."}
{"id": "sc-003", "question": "Even after counting my medical leave my attendance is short. Can the university condone it, and by how much?", "category": "scenario", "split": "tuning", "answerable": true, "expected_citations": ["srm/attendance/7.5-condonation_of_attendance"], "required_values": ["10"], "forbidden_values": ["25%", "15%", "20%"], "note": "In rare and genuine cases a committee examines it and the Dean CET may condone, but condonation cannot exceed 10% (7.5). 25% is the leave allowance in 7.3, not condonation."}
{"id": "sc-004", "question": "I scored 48% of the total normalized marks in a course. Have I passed it?", "category": "scenario", "split": "heldout", "answerable": true, "expected_citations": ["srm/attendance/8.2-method_of_awarding_letter_grades"], "required_values": ["50"], "forbidden_values": ["40%", "45%"], "note": "No. Passing needs at least 50% of the total normalized marks across continuous assessment and the end semester exam (8.2)."}
{"id": "sc-005", "question": "I failed a course last semester. Can I clear it in the summer semester, and can I withdraw if it gets too hard?", "category": "scenario", "split": "tuning", "answerable": true, "expected_citations": ["srm/attendance/3.5-summer_semester"], "required_values": [], "forbidden_values": [], "note": "Yes, summer semester courses are offered to clear failed/dropped courses, but withdrawal from summer semester courses is not permitted, and 75% attendance is required (3.5)."}
{"id": "sc-006", "question": "I lost my hall ticket the day before my exam. What should I do?", "category": "scenario", "split": "heldout", "answerable": true, "expected_citations": ["srm/examination/IX-conduct_of_theory_examinations"], "required_values": [], "forbidden_values": [], "note": "Approach the office of the COE; a duplicate hall ticket is collected after paying the necessary fee (IX (viii))."}
{"id": "sc-007", "question": "I am not happy with the marks in my result. How long do I have to ask for a revaluation?", "category": "scenario", "split": "tuning", "answerable": true, "expected_citations": ["srm/examination/XX-grievances"], "required_values": ["7"], "forbidden_values": ["14 days", "30 days"], "note": "Review, revaluation and retotaling can be applied for within 7 days from the declaration of results (XX)."}
